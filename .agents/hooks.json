{
  "quality-and-permission-gate": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/watch_and_verify.py --once --dry-run",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/watch_and_verify.py --once --dry-run",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
