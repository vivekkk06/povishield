{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://povishield.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://povishield.onrender.com/api"
    },
    {
      "source": "/install.sh",
      "destination": "https://povishield.onrender.com/install.sh"
    }
  ]
}
